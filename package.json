{
  "name": "tires-and-tread",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev/local.mjs up dev",
    "local": "node scripts/dev/local.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && pnpm --filter @tt/web typecheck",
    "boundaries": "node scripts/verify/boundaries.mjs",
    "contracts:generate": "node scripts/contracts/openapi.mjs",
    "contracts:check": "node scripts/contracts/openapi.mjs --check",
    "quality": "pnpm source:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm boundaries && pnpm contracts:check && pnpm db:check",
    "database": "node scripts/database/local.mjs",
    "db:check": "tsx scripts/database/check.ts",
    "test": "vitest run --project unit --project usecases --coverage",
    "test:unit": "vitest run --project unit",
    "test:usecases": "vitest run --project usecases",
    "test:db": "vitest run --project database",
    "test:foundation": "vitest run --project foundation",
    "test:schema": "vitest run --project schema",
    "test:recovery": "vitest run --project recovery",
    "verify:database": "node scripts/verify/database.mjs",
    "verify:recovery": "node scripts/verify/recovery.mjs",
    "test:http": "node scripts/verify/http.mjs",
    "test:gates": "node scripts/verify/gates.mjs",
    "build": "pnpm --filter @tt/web build && pnpm exec esbuild scripts/runtime/preflight.mjs --bundle --platform=node --format=esm --outfile=.local/preflight.mjs",
    "verify:local": "node scripts/verify/local.mjs",
    "verify:push": "node scripts/verify/push.mjs",
    "doctor:local": "node scripts/dev/local.mjs doctor",
    "source:check": "node scripts/verify/source.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@payloadcms/db-postgres": "3.92.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.5",
    "dependency-cruiser": "18.7.0",
    "drizzle-orm": "0.45.2",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "graphql": "16.14.2",
    "msw": "3.0.3",
    "payload": "3.92.0",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
