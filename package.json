{
  "name": "tires-and-tread",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev/local.mjs up dev",
    "local": "node scripts/dev/local.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && pnpm --filter @tt/web typecheck",
    "boundaries": "node scripts/verify/boundaries.mjs",
    "contracts:generate": "node scripts/contracts/openapi.mjs",
    "contracts:check": "node scripts/contracts/openapi.mjs --check",
    "quality": "pnpm source:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm boundaries && pnpm contracts:check && pnpm db:check && pnpm s3:check",
    "s3:check": "node scripts/verify/s3.mjs",
    "s3:acceptance": "node scripts/verify/s3.mjs --require-accepted",
    "database": "node scripts/database/local.mjs",
    "db:check": "tsx scripts/database/check.ts",
    "test": "vitest run --project unit --project usecases",
    "test:unit": "vitest run --project unit",
    "test:usecases": "vitest run --project usecases",
    "test:db": "vitest run --project database",
    "test:foundation": "vitest run --project foundation",
    "test:schema": "vitest run --project schema",
    "test:recovery": "vitest run --project recovery",
    "verify:database": "node scripts/verify/database.mjs",
    "verify:recovery": "node scripts/verify/recovery.mjs",
    "test:http": "node scripts/verify/http.mjs",
    "test:gates": "node scripts/verify/gates.mjs",
    "build": "pnpm --filter @tt/web build && node scripts/runtime/build.mjs",
    "verify:local": "node scripts/verify/local.mjs",
    "verify:push": "node scripts/verify/push.mjs",
    "doctor:local": "node scripts/dev/local.mjs doctor",
    "source:check": "node scripts/verify/source.mjs",
    "verify:data-access": "node scripts/verify/data-access.mjs",
    "test:coverage": "vitest run --project unit --project usecases --project database --coverage",
    "db:models": "node scripts/verify/storage-models.mjs",
    "data:dry-run": "tsx scripts/data/import.ts dry-run",
    "data:resume": "tsx scripts/data/import.ts resume",
    "data:status": "tsx scripts/data/import.ts status",
    "data:diff": "tsx scripts/data/import.ts diff",
    "data:publish": "tsx scripts/data/import.ts publish",
    "data:rollback": "tsx scripts/data/import.ts rollback",
    "data:source": "tsx scripts/data/source.ts",
    "data:source-probe": "tsx scripts/data/source-probe.ts",
    "verify:service-host": "node scripts/verify/service-host.mjs",
    "service-host": "tsx scripts/runtime/service-host.ts",
    "local:host": "node scripts/dev/service-host.mjs",
    "verify:provider": "node scripts/verify/provider.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-kms": "3.1156.0",
    "@aws-sdk/client-s3": "3.1156.0",
    "@eslint/js": "10.0.1",
    "@payloadcms/db-postgres": "3.92.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/yauzl": "3.4.0",
    "@vitest/coverage-v8": "5.0.5",
    "dependency-cruiser": "18.7.0",
    "drizzle-orm": "0.45.2",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "graphql": "16.14.2",
    "inngest": "4.26.0",
    "msw": "3.0.3",
    "payload": "3.92.0",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "yauzl": "3.4.0"
  }
}
