{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": [
    "packages/**/*.ts",
    "tests/**/*.ts",
    "scripts/database/**/*.ts",
    "scripts/runtime/**/*.ts",
    "scripts/data/**/*.ts",
    "scripts/deployment/**/*.ts",
    "scripts/capacity/**/*.ts",
    "infra/database/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "tests/probes"]
}
